# ==============================================================================
# Django OrgEventManager Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# DO NOT commit .env to version control!
# ==============================================================================

# Django Secret Key (Generate a secure 50+ character string)
SECRET_KEY=django-insecure-change-this-to-a-very-secret-key-for-production-1234567890

# Debug Mode (set to True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated list of hostnames/IPs)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# Option 1: Full DATABASE_URL connection string (Recommended for Supabase)
# Find this in Supabase Project Settings -> Database -> Connection string (URI)
# Example (Session pooler - port 5432 or Transaction pooler - port 6543):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# ==============================================================================
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Option 2: Discrete DB parameters (used as fallback if DATABASE_URL is not set)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_SSLMODE=require
